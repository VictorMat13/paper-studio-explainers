# Copy this file to .env and fill in ONE provider. Never commit .env (it is in .gitignore).
# Full walkthrough: SETUP.md

# fish or elevenlabs
VOICE_PROVIDER=fish

# ---- Fish Audio ----
# Key: https://fish.audio/app/api-keys/      API credit: https://fish.audio/app/developers/billing/
FISH_API_KEY=
# Your cloned voice id. `python3 tools/voice.py clone ...` fills this in for you.
FISH_VOICE_ID=
# s2.1-pro (default), s2.1-pro-free (no credit needed), drama-3 (most expressive, takes [directions])
FISH_MODEL=s2.1-pro

# ---- ElevenLabs ----
# Key: https://elevenlabs.io/app/api/api-keys  (permissions: Text to Speech, Voices read, User read)
ELEVENLABS_API_KEY=
# Your cloned voice id. `python3 tools/voice.py clone ...` fills this in for you.
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 (default), eleven_v3 or eleven_v4 (more expressive), eleven_flash_v2_5 (fast, cheap)
ELEVENLABS_MODEL=eleven_multilingual_v2
